# LLM Configuration
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=gpt-4o
# Optional; leave empty for services that do not require authentication.
AGENT_LLM_API_KEY=
# Include the API prefix when required, e.g. http://localhost:8080/v1.
AGENT_LLM_BASE_URL=

# Integration Test Configuration
# Set to 1 to enable integration tests that make real LLM requests
AGENT_ENGINE_INTEGRATION_TEST=0
