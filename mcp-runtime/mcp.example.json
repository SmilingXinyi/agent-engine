{
  "mcpServers": {
    "filesystem": {
      "disabled": false,
      "disabledTools": ["write_file", "edit_file"],
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/tmp/workspace"
      ],
      "maxLineLength": 67108864,
      "env": {},
      "dir": "/tmp"
    },
    "legacy-sse": {
      "disabled": true,
      "type": "sse",
      "url": "https://mcp.example.com/sse"
    },
    "remote": {
      "disabled": true,
      "url": "https://mcp.example.com/mcp",
      "headers": {
        "Authorization": "Bearer your-token"
      }
    }
  }
}
